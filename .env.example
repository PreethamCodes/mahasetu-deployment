SCHOLARSHIP_WEB_PORT=3000
REVENUE_WEB_PORT=3001
EXAMINATION_WEB_PORT=3002
UNIVERSITY_WEB_PORT=3003
DASHBOARD_WEB_PORT=3004
CORE_API_PORT=8000
REVENUE_API_PORT=8001
EXAMINATION_API_PORT=8002
UNIVERSITY_API_PORT=8003

REVENUE_DATABASE_URL=
REVENUE_USER=
REVENUE_PASSWORD=

EXAMINATION_DATABASE_URL=
EXAMINATION_API_KEY=

UNIVERSITY_DATABASE_URL=
UNIVERSITY_CLIENT_ID=
UNIVERSITY_CLIENT_SECRET=
UNIVERSITY_SIGNING_KEY=

# Set to enabled for local synthetic record access.
PORTAL_DEMO_ACCESS=disabled
REVENUE_PORTAL_BACKEND_URL=http://revenue-api:8001
EXAMINATION_PORTAL_BACKEND_URL=http://examination-api:8002
UNIVERSITY_PORTAL_BACKEND_URL=http://university-api:8003

SCHOLARSHIP_DATABASE_URL=
SCHOLARSHIP_SUPABASE_URL=
SCHOLARSHIP_PUBLISHABLE_KEY=
SCHOLARSHIP_STORAGE_KEY=
SCHOLARSHIP_COOKIE_SECURE=true

# Optional local PostgreSQL (profile local-db). scripts/bootstrap_local_db.py init generates these
# and all other synthetic credentials into .env.local-db, so you rarely need to set them by hand.
LOCAL_DB_PASSWORD=
LOCAL_DB_PORT=5433

# MahaSetu Core (profile core). The bootstrap script generates these into .env.local-db.
CORE_DATABASE_URL=
CORE_ENVIRONMENT=development
# Server credentials of at least 24 random characters. Never commit real values.
DASHBOARD_CLIENT_TOKEN=
OTP_HASH_KEY=
REQUESTER_TOKEN_SCHOLARSHIP=
# Demonstration only: lets the MahaSetu website show the one-time code. Refused when CORE_ENVIRONMENT=production.
OTP_DEMO_DISCLOSURE=disabled

# MahaSetu website (dashboard-web, started with the core profile). It uses DASHBOARD_CLIENT_TOKEN above.
# Set DASHBOARD_COOKIE_SECURE=false only for local HTTP demonstrations.
DASHBOARD_COOKIE_SECURE=true
# The simulated SMS inbox at /messages shows one-time codes and has no sign-in. Demonstration only.
DEMO_MESSAGE_INBOX=enabled
